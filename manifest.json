{
  "manifest_version": 3,
  "name": "APIScope — API Sniffer & Security Auditor",
  "version": "1.0.0",
  "description": "Real-time API sniffer, OWASP security header auditor, GraphQL inspector, and 1-click cURL/RestPocket exporter.",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
